@page "/gameoflife"

<PageTitle>Game Of Life</PageTitle>
<h1>Game Of Life</h1>

<p>Please Input height</p>
<input type="number" @bind="height" />

<p>Please input width</p>
<input type="number" @bind="width" />

<p>How much cells do you want to start Alive?</p>
<input type="number" @bind="aliveCount" />

<button @onclick="OnConfigSubmit">Create Board</button>
<button @onclick="Start" disabled="@(game is null || isRunning)">Resume</button>
<button @onclick="Stop" disabled="@(!isRunning)">Pause</button>

@if (cells is not null)
{
    var cellId = 0;
    
    @for (var row = 0; row < width; row++)
    {
        <div style="display: flex">
            @for (var col = 0; col < height; col++)
            {
                var id = cellId;
                <div @onclick="@(e => SwapState(id))" id="@(cellId++)" style="width: 16px; height: 16px; border: 1px solid #ddd; background: @(cells![row, col] ? "black" : "white")"></div>
            }
        </div>
    }
}
