@page "/gameoflife"

<PageTitle>Game Of Life</PageTitle>

<h1 class="page-title">Game Of Life</h1>

<div class="mainTitleWrapDiv">
    <div class="mainTitleDiv">
        <div class="centeringDiv ">
            <div>
                <label>
                    <p style="text-align: center">Height</p>
                    <input class="input" type="number" min="1" max="100" @bind="height" style="width: 8rem"/>
                </label>
                <div class="centeringDiv">
                    <button class="button" @onclick="OnConfigSubmit">Create Board</button>
                </div>
            </div>
            <div>
                <label>
                    <p style="text-align: center">Width</p>
                    <input class="input" type="number" min="1" max="100" @bind="width" style="width: 8rem"/>
                </label>
                <div class="centeringDiv">
                    <button class="button" @onclick="Resume">Resume</button>
                </div>
            </div>

            <div>
                <label>
                    <p style="text-align: center">Amount Alive</p>
                    <input class="input" type="number" min="1" max="100" @bind="aliveCount" style="width: 8rem"/>
                </label>
                <div class="centeringDiv">
                    <button class="button" @onclick="Stop" >Pause</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="centeringDiv">
    @if (cells is not null)
    {
        <div class="boardDiv">
            @for (var row = 0; row < cells.GetLength(0); row++)
            {
                <div style="display: flex">
                    @for (var col = 0; col < cells.GetLength(1); col++)
                    {
                        <div class="alive-or-dead @(cells![row, col] ? "alive" : "dead")" style="width: 16px; height: 16px;"></div>
                    }
                </div>
            }
        </div>
    }
</div>
